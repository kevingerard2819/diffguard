# Optional. Deterministic review and the seeded demo work without a model key.
# Free-tier requests may be used by Google to improve its products; submit only
# public or non-sensitive code. Never expose this key in client-side code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Best-effort per-instance protection for the public review endpoint. For a
# production multi-instance deployment, also configure provider and edge quotas.
DIFFGUARD_RATE_LIMIT_MAX=8
DIFFGUARD_RATE_LIMIT_WINDOW_SECONDS=600
